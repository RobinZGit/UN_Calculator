#!/bin/sh
# Увеличивает vN в легенде формы в index.html, если этот файл входит в коммит.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
if ! git diff --cached --name-only | grep -qx "index.html"; then
  exit 0
fi
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/bump-form-version.ps1"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/bump-form-version.ps1"
else
  echo "bump-form-version: нужен PowerShell (pwsh или powershell.exe) в PATH." >&2
  exit 1
fi
git add index.html
