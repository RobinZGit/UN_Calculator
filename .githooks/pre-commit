#!/bin/sh
# Перед каждым коммитом увеличивает vN во всех span.form-version в index.html и снова добавляет файл в индекс.
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
if command -v python3 >/dev/null 2>&1; then
  python3 "$ROOT/scripts/bump_form_version.py" hook
elif command -v python >/dev/null 2>&1; then
  python "$ROOT/scripts/bump_form_version.py" hook
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/bump-form-version.ps1"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/bump-form-version.ps1"
else
  echo "bump-form-version: нужны python3/python или PowerShell (pwsh/powershell.exe) в PATH." >&2
  exit 1
fi
git add index.html
